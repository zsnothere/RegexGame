import re, random

CONSONANTS = 'bcdfghjklmnpqrstvwxyz'
VOWELS = 'aeiou'
RULE_CHOICES = ['CV', 'abcdefghijklmnopqrstuvwxyz']

def check(regex, name):
    match = re.search(regex, name)
    if match: return match.group(0) == name.lower()
    return False

def replaceRandom(t, a, b):
    l = [i for i, c in enumerate(t) if c == a]
    if not l: return t
    t = list(t)
    t[random.choice(l)] = b
    return ''.join(t)

def generateName(rules):
    o = rules[0]*random.randint(1, 4)
    if rules[1]:
        for i in rules[1]:
            if i in CONSONANTS: o = replaceRandom(o, 'C', i)
            elif i in VOWELS: o = replaceRandom(o, 'V', i)
    o = list(o)
    for i in range(len(o)):
        if o[i] == 'C': o[i] = random.choice(CONSONANTS)
        elif o[i] == 'V': o[i] = random.choice(CONSONANTS)
    return ''.join(o).title()

def perturbIndividual(rule, i):
    rule = list(rule)
    rule[random.choice(range(len(rule)))] = random.choice(RULE_CHOICES[i])
    return ''.join(rule)

def perturb(rules, level):
    bad = rules.copy()
    l = [i for i, v in enumerate(bad) if v != '']
    for _ in range(random.randint(1, 3)):
        r = random.choice(l)
        bad[r] = perturbIndividual(bad[r], r)
    return bad

def generateQueue(rules, level):
    o = []
    for _ in range(random.randint(max(int(level*0.75), 1), max(int(level*1.25), level+1))):
        if random.randint(0, max(level//2, 1)): o.append(generateName(rules))
        else: o.append(generateName(perturb(rules, level)))
    return o

def addRule(rules):
    r = random.randint(0, len(RULE_CHOICES)-1)
    rules[r] += random.choice(RULES_CHOICES[r])

def generateChecker(rules):
    return [f'({rules[0].replace("C",f"[{CONSONANTS}]").replace("V",f"[{VOWELS}]")})*', ''.join([f'(?=.*{i})' for i in rules[1]])]

def checkAnswers(checker, name):
    o = True
    for i in checker:
        o = o and check(i, name)
    return o

